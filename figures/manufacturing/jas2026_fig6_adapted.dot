digraph G {
rankdir=LR;
graph [fontname="Helvetica", nodesep=0.18, ranksep=0.42, splines=true, pad=0.15];
node [fontname="Helvetica", fontsize=8];
edge [arrowsize=0.55, color="#40546b"];
"p_raw" [shape=circle, style="filled", fillcolor="#eef3f8", color="#04182e", label="p_raw\n(2)"];
"a1" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a1"];
"a2" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a2"];
"a3" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a3"];
"a4" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a4"];
"a5" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a5"];
"r1" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r1"];
"r2" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r2"];
"r3" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r3"];
"r4" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r4"];
"r5" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r5"];
"p_R1" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_R1\n(1)"];
"p_R2" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_R2\n(1)"];
"p_R3" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_R3\n(1)"];
"p_M1" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_M1\n(2)"];
"p_M2" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_M2\n(2)"];
"p_Ifree" [shape=ellipse, style="filled", fillcolor="#dbe4ee", color="#40546b", label="p_Ifree\n(1)"];
"a6" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="a6"];
"r6" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="r6"];
"p_slip" [shape=circle, style="filled", fillcolor="#ffffff", color="#40546b", label="p_slip"];
"p_done" [shape=circle, style="filled", fillcolor="#eef3f8", color="#04182e", label="p_done"];
"s1" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s1\n[0]"];
"c1" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="c1\n[3]"];
"s2" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s2\n[0]"];
"c2" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="c2\n[2]\n/machining_done/"];
"s3" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s3\n[0]"];
"c3" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="c3\n[6]\n/transfer_done/"];
"s4" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s4\n[0]"];
"c4" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="c4\n[2]\n/machining2_done/"];
"s5" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s5\n[0]"];
"c5" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="c5\n[4]\n/transfer2_done/"];
"s6" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="s6\n[0]"];
"c6" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="c6\n[4,6]"];
"pass" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="pass\n[0]\n/inspection_pass/"];
"rw" [shape=box, style="rounded,filled", fillcolor="#e6f0e2", color="#2f6b3a", fontcolor="#1d4424", label="rw\n[0]\n/inspection_rework/"];
"tf" [shape=box, style="rounded,filled", fillcolor="#f6e3d3", color="#b5651d", fontcolor="#8a4a12", label="tf\n[0,3]"];
"rec" [shape=box, style="rounded,filled", fillcolor="#f2f5f9", color="#04182e", fontcolor="#04182e", label="rec\n[1,3]"];
"p_raw" -> "s1";
"p_R1" -> "s1";
"s1" -> "a1";
"a1" -> "c1";
"c1" -> "r1";
"r1" -> "s2";
"p_M1" -> "s2";
"s2" -> "a2";
"s2" -> "p_R1";
"a2" -> "c2";
"c2" -> "r2";
"r2" -> "s3";
"p_R2" -> "s3";
"s3" -> "a3";
"s3" -> "p_M1";
"a3" -> "c3";
"c3" -> "r3";
"r3" -> "s4";
"p_M2" -> "s4";
"s4" -> "a4";
"s4" -> "p_R2";
"a4" -> "c4";
"c4" -> "r4";
"r4" -> "s5";
"p_R3" -> "s5";
"s5" -> "a5";
"s5" -> "p_M2";
"a5" -> "c5";
"c5" -> "r5";
"r5" -> "s6";
"p_Ifree" -> "s6";
"s6" -> "a6";
"s6" -> "p_R3";
"a6" -> "c6";
"c6" -> "r6";
"r6" -> "pass";
"pass" -> "p_done";
"pass" -> "p_Ifree";
"r6" -> "rw";
"p_M2" -> "rw";
"rw" -> "a4";
"rw" -> "p_Ifree";
"a1" -> "tf";
"tf" -> "p_slip";
"p_slip" -> "rec";
"rec" -> "a1";
{rank=same; "p_raw"; "s1";}
{rank=same; "a1"; "a2"; "a3"; "a4"; "a5"; "a6";}
{rank=same; "p_R1"; "p_M1"; "p_R2"; "p_M2"; "p_R3"; "p_Ifree";}
{rank=same; "p_done"; "p_slip";}
}
